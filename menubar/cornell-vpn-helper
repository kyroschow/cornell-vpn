#!/bin/bash
# Root helper for the Cornell VPN menu bar app. Installed to
# /usr/local/libexec/ (root-owned) and invoked through a narrow sudoers rule.
#
# WHY THIS EXISTS: the sudoers rule is NOPASSWD, so it must not be a way to run
# arbitrary code as root. Therefore this script:
#   - accepts only "up <netid>" and "down", and validates the netid
#   - hard-codes the openconnect binary, vpnc-script and config paths
#   - reads its config from a ROOT-OWNED file, so a user-writable config cannot
#     inject `script = /tmp/evil` (openconnect runs that script as root)
#   - verifies the SHA-256 of openconnect and vpnc-script against hashes
#     recorded at install time. Homebrew's prefix is user-writable, so without
#     this check anyone able to write /opt/homebrew could swap the binary and
#     escalate to root through the NOPASSWD rule.
#   - takes the VPN password on stdin, never in argv (argv is world-readable)
set -euo pipefail

OPENCONNECT=/opt/homebrew/bin/openconnect
# Routes-only wrapper, installed root-owned next to this helper. It must NOT
# live in the repo: this runs under a NOPASSWD sudo rule, and a user-writable
# script executed as root is exactly the escalation hole the rest of this file
# is built to avoid. It chains to the real vpnc-script below, which is what the
# integrity check covers.
VPNC_SCRIPT=/usr/local/libexec/cornell-vpn-vpnc-script
REAL_VPNC_SCRIPT=/opt/homebrew/etc/vpnc/vpnc-script
CONFDIR=/usr/local/etc/cornell-vpn
CONFIG="$CONFDIR/cornell.conf"
HASHES="$CONFDIR/integrity.sha256"
PIDFILE=/var/run/cornell-vpn.pid
LOG=/var/log/cornell-vpn.log

die() { printf 'cornell-vpn-helper: %s\n' "$*" >&2; exit 1; }

verify_integrity() {
    [ -f "$HASHES" ] || die "missing $HASHES - re-run install.sh"
    [ -x "$VPNC_SCRIPT" ] || die "missing $VPNC_SCRIPT - re-run install.sh"
    if ! shasum -a 256 -c "$HASHES" >/dev/null 2>&1; then
        die "integrity check FAILED for openconnect or vpnc-script.
    This is expected after 'brew upgrade openconnect' - re-run install.sh to
    re-record the hashes. If you did not upgrade, investigate before running."
    fi
}

case "${1:-}" in
    up)
        netid="${2:-}"
        [[ "$netid" =~ ^[A-Za-z0-9_-]{2,32}$ ]] || die "invalid netid"
        [ -f "$CONFIG" ] || die "missing $CONFIG - re-run install.sh"
        verify_integrity
        if pgrep -x openconnect >/dev/null 2>&1; then
            echo "already connected"; exit 0
        fi
        # Output goes to a root-owned log, NOT to our stdout. `--background`
        # daemonises, and the daemon inherits stdout for the life of the
        # tunnel; if that were the caller's pipe, any caller reading to EOF
        # would block until the VPN disconnected. The GUI did exactly that and
        # hung on "Connecting" while the tunnel was already up.
        : > "$LOG" 2>/dev/null || true
        chmod 600 "$LOG" 2>/dev/null || true
        set +e
        "$OPENCONNECT" \
            --config "$CONFIG" \
            --user "$netid" \
            --script "$VPNC_SCRIPT" \
            --passwd-on-stdin \
            --background \
            --pid-file "$PIDFILE" >>"$LOG" 2>&1
        rc=$?
        set -e
        # Hand the authentication output back so callers can distinguish a
        # rejected login from a network failure.
        sed -n '1,200p' "$LOG" 2>/dev/null || true
        exit "$rc"
        ;;
    down)
        pid="$(pgrep -x openconnect 2>/dev/null | head -1 || true)"
        [ -n "$pid" ] || { echo "not connected"; exit 0; }
        kill -TERM "$pid" 2>/dev/null || true
        for _ in $(seq 1 20); do
            kill -0 "$pid" 2>/dev/null || break
            sleep 0.25
        done
        kill -0 "$pid" 2>/dev/null && kill -KILL "$pid" 2>/dev/null || true
        rm -f "$PIDFILE" 2>/dev/null || true
        echo "disconnected"
        ;;
    *)
        die "usage: cornell-vpn-helper {up <netid>|down}"
        ;;
esac
