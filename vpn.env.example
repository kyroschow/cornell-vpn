# Copy to vpn.env and fill in. vpn.env is gitignored and dockerignored,
# so your real credentials stay on this machine.
#
# This file is mounted into the container as a Docker secret and parsed
# literally, so values may contain $, #, quotes, and spaces without escaping.
# Do NOT switch this to `env_file:` in compose.yaml - Compose interpolates $
# in env_file values and will silently corrupt a password containing one.

VPN_NETID=abc123
VPN_PASSWORD=your-netid-password

# Duo second factor: push | phone | sms | a 6-digit passcode
VPN_DUO=push

# Optional overrides
# VPN_HOST=cuvpn.cuvpn.cornell.edu
# VPN_GROUP=Two-Step_Login
# Overrides openconnect's path-MTU probe. Normally leave unset - the probe is
# right, including when it picks a low value on a constrained link like a phone
# hotspot. Forcing a too-high MTU causes silent packet loss.
# VPN_BASE_MTU=1500
