# openconnect config for Cornell CU VPN. Read by ./cornell-vpn.
# No password here - it is typed interactively at each connect.

protocol = anyconnect
server = https://cuvpn.cuvpn.cornell.edu
user = your-netid

# Required by Cornell since 2021-07-15.
authgroup = Two-Step_Login

# Duo second factor, supplied by form field name rather than prompt order.
# Change to "phone", "sms", or a 6-digit passcode if you prefer.
form-entry = main:secondary_password=push

# Routes and DNS are configured by this script (installed with openconnect).
script = /opt/homebrew/etc/vpnc/vpnc-script

# --- Optional, uncomment if needed -------------------------------------
# DTLS (UDP) is unreliable on some networks: the MTU probe fails, drops to the
# 576-byte IPv4 minimum, and the session keeps dying with "Dead Peer Detection
# detected dead peer". Check with: ifconfig utunN | grep mtu
# no-dtls = true
#
# cuvpn load-balances across vpn4-asa and vpn5-asa. If one is out of service a
# connection can hang before the login form appears. Pin a known-good node:
# server = https://vpn4-asa.cuvpn.cornell.edu
